APP_ENV=dev
APP_ADDR=:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/k8s_proxmox?sslmode=disable
AUTO_MIGRATE=true
TERRAFORM_BINARY=terraform
TERRAFORM_WORKDIR=infra/terraform/runs
TERRAFORM_PLUGIN_DIR=/terraform-providers
TERRAFORM_AUTO_APPLY=false
ANSIBLE_BINARY=ansible-playbook
ANSIBLE_WORKDIR=infra/ansible/runs
ANSIBLE_AUTO_APPLY=false
OPERATIONS_WORKDIR=data/operations/runs
KUBECONFIG_DIR=/root/.kube
JWT_SECRET=change-me-in-prod
SECRET_ENCRYPTION_KEY=dev-only-change-me-secret-key
JWT_TTL_MINUTES=120
PUBLIC_APP_URL=http://localhost:3000

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

PROXACLOUD_TUNNEL_ENABLED=false
PROXACLOUD_TUNNEL_API_URL=https://dashboard.proxaops.com
PROXACLOUD_TUNNEL_API_TOKEN=
PROXACLOUD_TUNNEL_GATEWAY_URL=wss://tunnel.proxaops.com/__agent/connect
PROXACLOUD_TUNNEL_PUBLIC_HOSTNAME=
PROXACLOUD_TUNNEL_HOSTNAME_SUFFIX=.proxaops.com
PROXACLOUD_TUNNEL_HTTP_TARGET_URL=http://127.0.0.1:80
PROXACLOUD_TUNNEL_SSH_HOST=127.0.0.1
PROXACLOUD_TUNNEL_SSH_PORT=22
PROXACLOUD_TUNNEL_PUBLIC_PORT_START=22000
PROXACLOUD_TUNNEL_PUBLIC_PORT_END=29999
PROXACLOUD_TUNNEL_AGENT_BINARY_URL=

CLOUDFLARE_DNS_ENABLED=false
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# These Cloudflare values bootstrap the first managed tunnel domain only.
# Add further zones from Zero Trust -> Managed Domains after deployment.
CLOUDFLARE_DOMAIN=proxaops.com
CLOUDFLARE_DNS_TARGET=tunnel.proxaops.com
CLOUDFLARE_DNS_RECORD_TYPE=CNAME
CLOUDFLARE_DNS_PROXIED=false
MANAGED_STOREFRONT_ENABLED=false
MANAGED_STOREFRONT_API_TOKEN=
MANAGED_STOREFRONT_BASE_DOMAIN=store.proxaops.com
MANAGED_STOREFRONT_TUNNEL_ID=
MANAGED_STOREFRONT_TARGET_URL=http://127.0.0.1:3000

SUPER_ADMIN_USERNAME=k8s-admin
SUPER_ADMIN_PASSWORD=ChangeMeNow!

DEFAULT_NETWORK_NAME=homelab-default
DEFAULT_NETWORK_CIDR=192.168.8.0/24
DEFAULT_NETWORK_GATEWAY=192.168.8.1
DEFAULT_NETWORK_DNS=1.1.1.1,8.8.8.8
DEFAULT_NETWORK_BRIDGE=vmbr0
DEFAULT_NETWORK_VLAN=0

HTTP_PORT=80
HTTPS_PORT=443
TLS_CERTS_DIR=./certs
